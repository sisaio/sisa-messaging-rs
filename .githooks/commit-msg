#!/bin/sh
# Checks a commit message against CONTRIBUTING.md#commit-messages. Git runs it on each commit once
# a clone sets `git config core.hooksPath .githooks`; CI runs it on a PR's commits and title.
set -eu

subject=$(grep -v '^#' "$1" | grep -m 1 . || true)

fail() {
  printf 'commit-msg: %s\n  %s\nSee CONTRIBUTING.md#commit-messages.\n' "$1" "$subject" >&2
  exit 1
}

case "$subject" in
  # Local autosquash commits pass; CI rejects them so none reaches main.
  fixup!* | squash!* | amend!*) [ -z "${CI:-}" ] && exit 0 ;;
esac

echo "$subject" |
  grep -Eq '^(feat|fix|perf|refactor|docs|test|build|ci|chore|revert)(\((core|runtime|nats|iggy|postgres|testing|facade|deps)\))?!?: [^ ]' ||
  fail 'start with type(scope): summary, for example "fix(postgres): release a claimed row on shutdown"'
[ "${#subject}" -le 72 ] || fail 'keep the subject to 72 characters'
case "$subject" in
  *.) fail 'end the subject without a period' ;;
  *'[skip ci]'* | *'[ci skip]'*) fail 'put [skip ci] in the body, not the subject' ;;
esac
if grep -iq '^co-authored-by:' "$1"; then fail 'drop the Co-authored-by trailer'; fi

# A breaking change says how to migrate in its body. CI checks a PR title with SUBJECT_ONLY set,
# since a title has no body.
case "$subject" in
  *'!:'*)
    if [ -z "${SUBJECT_ONLY:-}" ] &&
      ! grep -v '^#' "$1" | awk 'seen && NF { found = 1 } NF { seen = 1 } END { exit !found }'; then
      fail 'a breaking change says how to migrate in the body'
    fi
    ;;
esac
